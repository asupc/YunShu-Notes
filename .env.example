# 云树笔记环境变量示例（SQLite 轻量版，无需 PostgreSQL / Redis / MinIO）
PORT=3001
WS_PORT=3002
PUBLIC_API_BASE=http://127.0.0.1:3001
DATA_DIR=./data
SQLITE_PATH=./data/yunshu.db
JWT_SECRET=yunshu-dev-jwt-secret-change-me
# ONLYOFFICE Docs 社区版（可选：配置后 Word/Excel 开启在线编辑）
ONLYOFFICE_URL=
ONLYOFFICE_JWT_SECRET=yunshu-onlyoffice-secret-change-me
ONLYOFFICE_INTERNAL_API_BASE=
ONLYOFFICE_INTERNAL_URL=
# 开启按需自动启停：平时不占内存，点击「在线编辑」自动唤醒，空闲超时自动停止
ONLYOFFICE_ON_DEMAND=true
ONLYOFFICE_CONTAINER_NAME=yunshu-onlyoffice
ONLYOFFICE_IDLE_MINUTES=15
