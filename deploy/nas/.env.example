# 复制为 .env 后填写；JWT_SECRET 用 `openssl rand -hex 32` 生成
PUBLIC_API_BASE=https://note.678120.cn:8888
JWT_SECRET=change-me-to-a-random-64-hex-string
ALLOW_REGISTRATION=false
# ONLYOFFICE Docs 社区版（浏览器可访问的地址）。
# 推荐走同源反代：nginx 将 /onlyoffice/ 转发到宿主 127.0.0.1:8088。
ONLYOFFICE_URL=https://note.678120.cn:8888/onlyoffice
# 随机密钥，用 `openssl rand -hex 32` 生成；服务端与 onlyoffice 容器共用，必须一致
ONLYOFFICE_JWT_SECRET=change-me-to-another-random-64-hex-string
# ONLYOFFICE 容器回调云树服务端的内网地址（两者同在 docker_network）
ONLYOFFICE_INTERNAL_API_BASE=http://yunshu-server:3001
# ONLYOFFICE 容器自身的容器内网地址（保存回调取文件用，一般无需修改）
ONLYOFFICE_INTERNAL_URL=http://yunshu-onlyoffice
# 开启按需自动启停：平时不占内存，点击「在线编辑」自动唤醒，空闲超时自动停止
ONLYOFFICE_ON_DEMAND=true
ONLYOFFICE_CONTAINER_NAME=yunshu-onlyoffice
ONLYOFFICE_IDLE_MINUTES=15
